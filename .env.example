# =============================================================================
# Playwright BDD framework — environment (copy to .env)
# Booleans accept: true | false | 1 | 0 | yes | no | on | off
# Artifact modes accept: off | on | retain-on-failure
# npm scripts (cross-env) override these for that run only.
# =============================================================================

# --- Application -------------------------------------------------------------

# BASE_URL — origin of the AUT (no trailing-slash required).
# Suggested: https://corebanking.testingprofessor.net/
# Behaviour: Playwright context baseURL; launch/login navigate here.
BASE_URL=https://corebanking.testingprofessor.net/

# APP_USERNAME — login email / username.
# Suggested: your bank-manager email
# Behaviour: required by "I sign in with valid credentials" and first-time session reuse.
APP_USERNAME=

# APP_PASSWORD — login password.
# Suggested: plain text once, then run `npm run secret:encrypt` so it becomes enc.v1....
# Behaviour: if enc.v1..., decrypted with APP_ENCRYPTION_KEY. If plain, it is encrypted and rewritten on first use.
APP_PASSWORD=

# APP_ENCRYPTION_KEY — 64 hex chars (32-byte key) used to decrypt enc.v1 passwords.
# Suggested: leave generated value; do not commit. Empty = framework generates one on first encrypt.
# Behaviour: required whenever APP_PASSWORD starts with enc.v1.
APP_ENCRYPTION_KEY=

# --- Browser / run mode ------------------------------------------------------

# BROWSER — which engine to launch locally.
# Suggested: chrome (installed Chrome) | chromium | firefox | webkit | msedge
# Behaviour: chrome/msedge map to Playwright Chromium + channel. firefox/webkit use bundled engines. Used in run name / RUN_ID.
BROWSER=chrome

# BROWSER_CHANNEL — installed-browser channel for Chromium only.
# Suggested: chrome | msedge | chrome-beta | msedge-beta | (empty = Playwright bundled Chromium)
# Behaviour: ignored for firefox/webkit. If Chrome is missing, launch falls back to bundled Chromium headed.
BROWSER_CHANNEL=chrome

# HEADLESS — hide the browser UI.
# Suggested: false for local watching | true for CI
# Behaviour: KEEP_BROWSER_OPEN=true forces headed even if this is true.
HEADLESS=false

# KEEP_BROWSER_OPEN — leave the window open after each scenario.
# Suggested: false normally | true while debugging a single scenario
# Behaviour: skips page/context close. AfterAll waits for Enter (or KEEP_BROWSER_OPEN_MS).
KEEP_BROWSER_OPEN=false

# KEEP_BROWSER_OPEN_MS — auto-close delay when KEEP_BROWSER_OPEN=true.
# Suggested: 0 = wait for Enter in the terminal | 30000 = close after 30s
# Behaviour: only used when KEEP_BROWSER_OPEN=true.
KEEP_BROWSER_OPEN_MS=0

# LOGIN_PAUSE_MS — intended pause after login (ms). npm headed scripts set 3000; CI should use 0.
# Suggested: 3000 headed | 0 headless/CI
# Behaviour: loaded into env.loginPauseMs (npm scripts pass this; keep 0 in CI).
LOGIN_PAUSE_MS=3000

# CLICK_PAUSE_MS — pause after observed clicks so headed runs are easy to follow.
# Suggested: 800 headed | 0 CI/headless
# Behaviour: WaitConditions.observe() after clicks unless the action passes { observe: false }.
CLICK_PAUSE_MS=800

# SLOW_MO — Playwright launch slowMo (ms between operations).
# Suggested: 0 normal | 250 slow-motion debug
# Behaviour: applied to browser.launch() for Chromium, Firefox, and WebKit.
SLOW_MO=0

# LAUNCH_TIMEOUT — max wait for the browser process to start (ms).
# Suggested: 180000 | 0 = Playwright default (no timeout)
# Behaviour: browser.launch() timeout. BrowserStack uses BROWSERSTACK_CONNECT_TIMEOUT instead.
LAUNCH_TIMEOUT=180000

# MAXIMIZE_WINDOW — fill the screen in headed local runs.
# Suggested: true headed | false to use VIEWPORT_WIDTH/HEIGHT instead
# Behaviour: Chromium uses --start-maximized + CDP. Firefox/WebKit resize via JS. Ignored when HEADLESS=true or EXECUTION_ENV=browserstack.
MAXIMIZE_WINDOW=true

# IGNORE_HTTPS_ERRORS — continue on invalid TLS certificates.
# Suggested: true for test envs | false if you want cert failures to fail the run
# Behaviour: context.ignoreHTTPSErrors for every engine (Chrome, Edge, Firefox, WebKit, BrowserStack).
IGNORE_HTTPS_ERRORS=true

# ACCEPT_DOWNLOADS — let Playwright take over file downloads.
# Suggested: true
# Behaviour: context.acceptDownloads + launch downloadsPath=reports/downloads. Firefox also sets download prefs.
ACCEPT_DOWNLOADS=true

# BYPASS_CSP — ignore Content-Security-Policy on the page.
# Suggested: false unless a test env CSP blocks needed scripts
# Behaviour: context.bypassCSP for all browsers.
BYPASS_CSP=false

# CHROMIUM_SANDBOX — Chromium OS sandbox (Chrome / Edge / bundled Chromium only).
# Suggested: true locally | false in Docker/CI (CI=true already forces false)
# Behaviour: ignored for Firefox/WebKit.
CHROMIUM_SANDBOX=

# LOCALE — UI locale / Accept-Language.
# Suggested: en-US
# Behaviour: context.locale + Accept-Language header so date/number formats match across OS browsers.
LOCALE=en-US

# TIMEZONE — IANA timezone for Date in the page.
# Suggested: empty = host timezone | Asia/Kolkata | America/New_York
# Behaviour: unset = do not emulate. Set to pin dates across CI agents.
TIMEZONE=

# COLOR_SCHEME — prefers-color-scheme.
# Suggested: empty = browser default | light | dark | no-preference
# Behaviour: context.colorScheme. Empty leaves the engine default.
COLOR_SCHEME=

# USER_AGENT — override the browser UA string.
# Suggested: empty = engine default
# Behaviour: applied to the context for every local/remote browser when set.
USER_AGENT=

# BROWSER_ARGS — extra launch args (comma or semicolon separated).
# Suggested: empty | e.g. --mute-audio
# Behaviour: appended after engine defaults. Chromium flags only apply to Chrome/Edge/Chromium.
BROWSER_ARGS=

# PERMISSIONS — Playwright context permissions (comma separated).
# Suggested: empty | clipboard-read,clipboard-write
# Behaviour: empty → Chromium grants clipboard-read/write; Firefox/WebKit grant none (notifications stay blocked).
PERMISSIONS=

# EXTRA_HTTP_HEADERS — extra headers on every request (Name=value, comma separated).
# Suggested: empty | X-Test-Run=local
# Behaviour: merged after Accept-Language. Applies to all engines.
EXTRA_HTTP_HEADERS=

# PROXY_SERVER / PROXY_USERNAME / PROXY_PASSWORD — outbound proxy for launch + context.
# Suggested: empty | http://127.0.0.1:8080
# Behaviour: applied to Chromium, Firefox, and WebKit when PROXY_SERVER is set.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# DEVICE_SCALE_FACTOR — DPR when using a fixed viewport (headless / Firefox / WebKit).
# Suggested: empty | 1 | 2
# Behaviour: ignored when Chromium is headed+maximized (viewport is null).
DEVICE_SCALE_FACTOR=

# PARALLEL — Cucumber worker processes.
# Suggested: 1 local | 4 for faster suites (`npm run test:parallel`)
# Behaviour: cucumber.js --parallel. Shared buffer + manager session file are lock-protected.
PARALLEL=1

# RETRY — extra Cucumber attempts per failing scenario.
# Suggested: 0 local | 1 in CI to absorb flakes
# Behaviour: cucumber.js retry count. 0 = no rerun.
RETRY=0

# EXECUTION_ENV — where the browser runs.
# Suggested: local | browserstack
# Behaviour: local launches Chrome/Firefox/WebKit. browserstack uses CDP WebSocket (needs BS credentials).
EXECUTION_ENV=local

# --- Self-heal locators ------------------------------------------------------

# SELF_HEAL_ENABLED — retry a failed locator with cache → role/text/label heuristics.
# Suggested: false until you want healing | true to reduce locator flakes
# Behaviour: PlaywrightActions wraps click/fill/etc. Alias: SELF_HEAL.
SELF_HEAL_ENABLED=false

# SELF_HEAL_USE_LLM — after heuristics fail, ask the LLM for an alternative locator.
# Suggested: false unless LLM_ENABLED=true and LLM_API_KEY is set
# Behaviour: no-op if LLM is off or the API key is empty.
SELF_HEAL_USE_LLM=false

# SELF_HEAL_TIMEOUT_MS — budget for one heal attempt (ms).
# Suggested: 2500
# Behaviour: healing gives up after this and the original error is thrown.
SELF_HEAL_TIMEOUT_MS=2500

# --- Artifacts (screenshots / video / trace) ---------------------------------
# Modes: off = never | on = always keep | retain-on-failure = record, keep only if the scenario failed

# SCREENSHOT — screenshot at scenario end (After hook).
# Suggested: retain-on-failure CI | on when you want every scenario image
# Behaviour: reports/screenshots/*.png, attached to Cucumber/Extent.
SCREENSHOT=retain-on-failure

# STEP_SCREENSHOT — screenshot after every Gherkin step.
# Suggested: off (noisy/slow) | on for Extent step-by-step evidence
# Behaviour: reports/screenshots/steps/*.png, inlined on the Extent step.
STEP_SCREENSHOT=off

# ACTION_SCREENSHOT — screenshot after every PlaywrightActions UI action (click/fill/goto/…).
# Suggested: off (very noisy) | on for deep Extent debugging | retain-on-failure for failed actions only
# Behaviour: reports/screenshots/actions/*.png, embedded on each Extent activity row.
ACTION_SCREENSHOT=off

# SCREENSHOT_FULL_PAGE — full page vs viewport-only for those screenshots.
# Suggested: true for long forms | false for faster, smaller files
# Behaviour: Playwright page.screenshot({ fullPage }).
SCREENSHOT_FULL_PAGE=true

# TRACE — Playwright tracing (screenshots + DOM snapshots + sources).
# Suggested: off locally | retain-on-failure or on when debugging
# Behaviour: recording starts if on/retain-on-failure. Zip kept per mode. reports/traces/*.zip
TRACE=off

# VIDEO — Playwright context.recordVideo.
# Suggested: retain-on-failure
# Behaviour: recordings/test-runs/*.webm, linked from Extent test detail.
VIDEO=retain-on-failure

# --- Timeouts / viewport / logging -------------------------------------------

# VIEWPORT_WIDTH / VIEWPORT_HEIGHT — window size (px).
# Suggested: 1280 and 720 | 1920 and 1080
# Behaviour: used for headless Chromium (--window-size), Firefox, WebKit, BrowserStack, and video size.
# Headed Chromium with MAXIMIZE_WINDOW=true still uses viewport:null (real maximized window).
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# DEFAULT_TIMEOUT — Playwright default timeout for actions/assertions (ms).
# Suggested: 30000
# Behaviour: context.setDefaultTimeout().
DEFAULT_TIMEOUT=30000

# NAVIGATION_TIMEOUT — Playwright navigation timeout (ms).
# Suggested: 30000
# Behaviour: context.setDefaultNavigationTimeout(); login wait uses at least this (min 45s in LoginPage).
NAVIGATION_TIMEOUT=30000

# CUCUMBER_TIMEOUT — default Cucumber step/hook timeout (ms). Individual steps may set higher.
# Suggested: 60000 | 120000 in CI
# Behaviour: cucumber.js timeout + setDefaultTimeout in hooks.
CUCUMBER_TIMEOUT=60000

# LOG_LEVEL — Winston console/file verbosity.
# Suggested: info | debug while diagnosing | warn/error to quiet runs
# Behaviour: logger.ts level.
LOG_LEVEL=info

# --- Database (optional history) ---------------------------------------------

# DB_ENABLED — persist runs/scenarios/failures/insights to MySQL or Postgres.
# Suggested: false unless docker/local DB is up | true for the dashboard history
# Behaviour: false = JSON under reports/history/ only. Tests still run if DB is down.
DB_ENABLED=false

# DB_TYPE — driver.
# Suggested: mysql | postgres
# Behaviour: picks mysql2 vs pg. Default port follows this if DB_PORT is unset.
DB_TYPE=mysql

# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME — connection.
# Suggested: localhost, 3306 (mysql) or 5432 (postgres), root / password / playwright_framework
# Behaviour: used by src/db. Compose maps host mysql when running in Docker.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=playwright_framework

# --- LLM / Ollama (failure triage + optional self-heal) ----------------------
# LLM_ENABLED and OLLAMA_ENABLED are THE SAME switch. Prefer LLM_ENABLED.
# OLLAMA_HOST / OLLAMA_MODEL / OLLAMA_API_KEY alias LLM_HOST / LLM_MODEL / LLM_API_KEY.

# LLM_ENABLED — run AfterAll failure triage (and allow LLM self-heal if that flag is on).
# Suggested: true when the AI server + key work | false to skip AI
# Behaviour: false skips triage and writes the custom failure HTML only.
LLM_ENABLED=false

# LLM_HOST — Ollama-compatible server (scheme added if missing).
# Suggested: http://localaiserver.testingprofessor.net | http://127.0.0.1:11434 for local Ollama
# Behaviour: /api/tags and /api/chat (or OpenAI /v1 if LLM_API=openai).
LLM_HOST=http://localaiserver.testingprofessor.net

# LLM_MODEL — chat model, or auto to let the router pick.
# Suggested: auto
# Behaviour: auto + LLM_ROUTE=true uses llama3 to classify complexity then pick a model.
LLM_MODEL=auto

# LLM_ROUTER_MODEL — small model used only to classify simple vs complex failures.
# Suggested: llama3
# Behaviour: used when LLM_ROUTE=true and LLM_MODEL=auto.
LLM_ROUTER_MODEL=llama3

# LLM_COMPLEX_MODEL — fallback when no ~32B model is installed.
# Suggested: gemma4:latest
# Behaviour: used for complex triage after the 32B preference fails.
LLM_COMPLEX_MODEL=gemma4:latest

# LLM_PREFER_BILLION — target parameter size for complex analysis.
# Suggested: 32
# Behaviour: prefers catalog models in about the 27–40B band (names like :32b).
LLM_PREFER_BILLION=32

# LLM_ROUTE — enable complexity routing.
# Suggested: true | false to always use LLM_MODEL / LLM_COMPLEX_MODEL
# Behaviour: false + a fixed LLM_MODEL skips the llama3 router.
LLM_ROUTE=true

# LLM_API — protocol.
# Suggested: ollama | openai | auto (try ollama then openai, or reverse)
# Behaviour: ollama = /api/tags + /api/chat. openai = /v1/models + /v1/chat/completions.
LLM_API=ollama

# LLM_API_KEY — bearer + X-API-Key for the hosted server.
# Suggested: required for localaiserver.testingprofessor.net; empty for unsecured local Ollama
# Behaviour: catalog/chat return 401 without a key on the hosted host.
LLM_API_KEY=

# LLM_TIMEOUT_MS — HTTP timeout for chat/health (ms).
# Suggested: 90000
# Behaviour: abort long generations; triage then fails that scenario insight.
LLM_TIMEOUT_MS=90000

# --- BrowserStack (only when EXECUTION_ENV=browserstack) ---------------------

# BROWSERSTACK_USERNAME / BROWSERSTACK_ACCESS_KEY — cloud credentials.
# Suggested: from BrowserStack account; empty for local runs
# Behaviour: required if EXECUTION_ENV=browserstack. npm run test:browserstack.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# BROWSERSTACK_OS / BROWSERSTACK_OS_VERSION — remote OS.
# Suggested: OS X + Sonoma | Windows + 11
# Behaviour: sent in Playwright CDP capabilities.
BROWSERSTACK_OS=OS X
BROWSERSTACK_OS_VERSION=Sonoma

# BROWSERSTACK_BROWSER / BROWSERSTACK_BROWSER_VERSION — remote browser.
# Suggested: chrome + latest
# Behaviour: BrowserStack browser name/version, not the local BROWSER key.
BROWSERSTACK_BROWSER=chrome
BROWSERSTACK_BROWSER_VERSION=latest

# BROWSERSTACK_BUILD_NAME — label in the BrowserStack dashboard.
# Suggested: playwright-bdd-framework or a CI build id
BROWSERSTACK_BUILD_NAME=playwright-bdd-framework

# BROWSERSTACK_PROJECT_NAME — project grouping in the BrowserStack dashboard.
# Suggested: Playwright BDD Cucumber
BROWSERSTACK_PROJECT_NAME=Playwright BDD Cucumber

# BROWSERSTACK_RESOLUTION — remote desktop resolution (WxH).
# Suggested: 1280x720 | 1920x1080
# Behaviour: sent as the BrowserStack resolution capability. Defaults to VIEWPORT_WIDTH x VIEWPORT_HEIGHT.
BROWSERSTACK_RESOLUTION=

# BROWSERSTACK_LOCAL — BrowserStack Local tunnel.
# Suggested: false unless the AUT is not publicly reachable
# Behaviour: browserstack.local capability. Requires BrowserStack Local running separately.
BROWSERSTACK_LOCAL=false

# BROWSERSTACK_VIDEO / BROWSERSTACK_NETWORK_LOGS / BROWSERSTACK_DEBUG — session artifacts.
# Suggested: true
# Behaviour: video, network logs, and visual logs on the BrowserStack session.
BROWSERSTACK_VIDEO=true
BROWSERSTACK_NETWORK_LOGS=true
BROWSERSTACK_DEBUG=true

# BROWSERSTACK_CONSOLE — remote console capture level.
# Suggested: info | errors | warnings | disable
BROWSERSTACK_CONSOLE=info

# BROWSERSTACK_PLAYWRIGHT_VERSION — pin the BrowserStack Playwright protocol version.
# Suggested: empty = local playwright package version (1.62.x)
BROWSERSTACK_PLAYWRIGHT_VERSION=

# BROWSERSTACK_CONNECT_TIMEOUT — CDP WebSocket connect timeout (ms).
# Suggested: 120000
BROWSERSTACK_CONNECT_TIMEOUT=120000

# --- Reporting / run identity ------------------------------------------------

# ALLURE_RESULTS_DIR — raw Allure results folder.
# Suggested: reports/allure-results
# Behaviour: cucumber Allure formatter + `npm run allure:generate`.
ALLURE_RESULTS_DIR=reports/allure-results

# DASHBOARD_PORT — Express historical dashboard.
# Suggested: 3000
# Behaviour: `npm run dashboard:start` listens here (http://localhost:3000).
DASHBOARD_PORT=3000

# RUN_ID — force a shared run id across workers.
# Suggested: leave empty (auto: chrome-local-dd-mm-yyyy-hh-mm-ss)
# Behaviour: empty → cucumber.js writes RUN_ID + RUN_NAME. Set in CI to group a matrix.
RUN_ID=
