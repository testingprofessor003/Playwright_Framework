# Application
BASE_URL=https://corebanking.testingprofessor.net/
APP_USERNAME=
APP_PASSWORD=
APP_ENCRYPTION_KEY=
BROWSER=chrome
BROWSER_CHANNEL=chrome
HEADLESS=false
KEEP_BROWSER_OPEN=false
KEEP_BROWSER_OPEN_MS=0
LOGIN_PAUSE_MS=3000
# Mild pause after every button click so headed runs are easy to watch.
CLICK_PAUSE_MS=800
SLOW_MO=0
PARALLEL=1
RETRY=0
# Self-heal broken locators at runtime (cache → role/text/label heuristics → optional LLM).
SELF_HEAL_ENABLED=false
SELF_HEAL_USE_LLM=false
SELF_HEAL_TIMEOUT_MS=2500
# Artifacts: off | on | retain-on-failure
# SCREENSHOT = scenario-end screenshot. STEP_SCREENSHOT = after every Gherkin step.
SCREENSHOT=retain-on-failure
STEP_SCREENSHOT=off
SCREENSHOT_FULL_PAGE=true
TRACE=off
# Playwright scenario videos: off | on | retain-on-failure
# Saved under recordings/test-runs/ and linked from the Extent report detail page.
VIDEO=retain-on-failure
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
CUCUMBER_TIMEOUT=60000
LOG_LEVEL=info
EXECUTION_ENV=local

# Database (mysql | postgres). Leave DB_ENABLED=false to use JSON history only.
DB_ENABLED=false
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=playwright_framework

# Local AI server (Ollama API). LLM_ENABLED and OLLAMA_ENABLED are the same on/off switch.
# Prefer LLM_ENABLED. OLLAMA_HOST / OLLAMA_MODEL / OLLAMA_API_KEY alias LLM_HOST / LLM_MODEL / LLM_API_KEY.
LLM_ENABLED=true
LLM_HOST=http://localaiserver.testingprofessor.net
LLM_MODEL=auto
LLM_ROUTER_MODEL=llama3
LLM_COMPLEX_MODEL=gemma4:latest
LLM_PREFER_BILLION=32
LLM_ROUTE=true
LLM_API=ollama
LLM_API_KEY=
LLM_TIMEOUT_MS=90000

# BrowserStack
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_OS=OS X
BROWSERSTACK_OS_VERSION=Sonoma
BROWSERSTACK_BROWSER=chrome
BROWSERSTACK_BROWSER_VERSION=latest
BROWSERSTACK_BUILD_NAME=playwright-bdd-framework

# Reporting
ALLURE_RESULTS_DIR=reports/allure-results
DASHBOARD_PORT=3000
RUN_ID=
# Extent-style activity report is written to reports/extent/index.html after each run.
# Step screenshots appear inline when STEP_SCREENSHOT=on.
# Scenario videos are saved under recordings/test-runs/ and linked/embedded on the Extent test detail page.
